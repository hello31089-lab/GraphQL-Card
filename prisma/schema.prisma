datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client-js"
}

model Profile {
    id          String       @id @default(uuid())
    pictureId   String?
    name        String
    description String
    githubUrl   String?
    linkedinUrl String?
    otherUrl    String?
    skills      Skill[]
    experiences Experience[]
    projects    Project[]
    createdAt   DateTime     @default(now())
    updatedAt   DateTime     @updatedAt
}

model Skill {
    id        String   @id @default(uuid())
    name      String
    profileId String
    profile   Profile  @relation(fields: [profileId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}

model Experience {
    id           String    @id @default(uuid())
    company      String
    position     String
    startDate    DateTime
    endDate      DateTime?
    achievements String[]
    profileId    String
    profile      Profile   @relation(fields: [profileId], references: [id])
    createdAt    DateTime  @default(now())
    updatedAt    DateTime  @updatedAt
}

model Project {
    id        String   @id @default(uuid())
    name      String
    url       String
    profileId String
    profile   Profile  @relation(fields: [profileId], references: [id])
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
}
